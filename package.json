{
  "name": "playwright-conduit-bdd",
  "version": "1.0.0",
  "description": "E2E automation test Conduit dengan Playwright + BDD (Gherkin)",
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:headed": "bddgen && playwright test --headed",
    "test:ui": "bddgen && playwright test --ui",
    "test:login": "bddgen && playwright test --grep @login",
    "test:register": "bddgen && playwright test --grep @register",
    "test:smoke": "bddgen && playwright test --grep @smoke",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "allure:clean": "rm -rf allure-results allure-report",
    "allure:generate": "allure generate allure-results -o allure-report --clean",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "test:allure": "npm run allure:clean; npm test; npm run allure:report"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "allure": "^3.33.0",
    "allure-playwright": "^3.14.0",
    "dotenv": "^18.0.10",
    "playwright-bdd": "^9.2.1",
    "typescript": "^7.0.2"
  }
}